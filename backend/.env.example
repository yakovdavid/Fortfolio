# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role: internal jobs only (DSVE sync / watermarks). Bypasses RLS. NEVER ship to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Publishable (anon) key: used together with the user's JWT so RLS applies to every user read.
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
# Leave EMPTY on projects using asymmetric JWT signing keys (default for new projects):
# tokens are then verified against {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# Set only if the project still uses the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# --- Internal service-to-service auth (X-API-Key on /internal/*). Never ship to the client. ---
BACKEND_API_KEY=generate-a-long-random-string

# --- CORS: comma-separated browser origins allowed to call the API (Expo web/dev) ---
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- DSVE tuning (defaults match the PRD; override only if needed) ---
MARKET_DATA_TTL_MINUTES=15
SYNC_INTERVAL_SECONDS=900
QUOTE_CONCURRENCY=4
YAHOO_MAX_RETRIES=3
# Python weekday: Monday=0 ... Saturday=5 (after TASE Thu + US Fri closes)
WATERMARK_UPDATE_WEEKDAY=5
